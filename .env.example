# Copiare questo file in `.env` e riempirlo. `.env` non va nel repository.

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
#
# Servono DUE stringhe di connessione allo stesso database:
#
#   DATABASE_URL  connessione condivisa (pooled) — la usa l'app a ogni richiesta.
#                 Su Neon è quella con "-pooler" nel nome dell'host.
#   DIRECT_URL    connessione diretta — la usano solo i comandi `prisma migrate`,
#                 `prisma db push` e `prisma studio`, che vogliono una sessione stabile.
#
# In sviluppo, se il database è locale o è un branch Neon senza pooler, si possono
# impostare entrambe allo stesso valore.

DATABASE_URL="postgresql://utente:password@host/prenotazioni?sslmode=require"
DIRECT_URL="postgresql://utente:password@host/prenotazioni?sslmode=require"

# ─── Sessione ─────────────────────────────────────────────────────────────────
#
# Firma i cookie di accesso. In produzione deve essere di almeno 32 caratteri
# (l'app si rifiuta di partire altrimenti) e DIVERSO da quello di sviluppo.
# Generarne uno nuovo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET="cambiami-in-produzione-con-una-stringa-casuale-lunga"

# ─── Primo avvio in produzione (solo per `npm run db:bootstrap`) ──────────────
#
# Credenziali dell'unico amministratore creato al primo avvio. Non servono
# all'app in esecuzione: si impostano una volta sola, al momento del bootstrap.
# La password deve rispettare la politica del progetto (almeno 12 caratteri per
# un amministratore) e va cambiata al primo accesso.

# ADMIN_EMAIL="segreteria@circolo.it"
# ADMIN_PASSWORD=""
# ADMIN_NOME="Anna"
# ADMIN_COGNOME="Bianchi"
# NOME_CIRCOLO="Circolo Piscina"
