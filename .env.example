# Database. In sviluppo si usa SQLite (nessuna installazione richiesta).
# In produzione sostituire con l'URL PostgreSQL e cambiare `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Segreto per firmare i cookie di sessione. In produzione generarne uno nuovo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiami-in-produzione-con-una-stringa-casuale-lunga"
